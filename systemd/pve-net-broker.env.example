# Copy this to pve-net-broker.env and adjust values.
# scripts/ensure-env.sh 가 install/deploy 때 이 파일이 없으면 만들고, API_KEY 가 비어 있으면 채운다(멱등).

# 바인드 = vmbr1 게이트웨이 주소만. 0.0.0.0 으로 두면 사내망 인터페이스에도 열린다 — 하지 않는다.
API_HOST=10.10.10.1
API_PORT=7100
LOG_LEVEL=info
STATE_DB_PATH=/opt/pve-net-broker/data/state.db
LEASE_DEFAULT_TTL=300

# 예약·갱신·해제(X-Api-Key). 비어 있으면 그 경로는 503 으로 전부 거절된다(fail-closed).
# 호출자(VHS·pnbctl)에게 이 값을 준다. pnbctl 은 이 파일에서 직접 읽는다.
API_KEY=

# vm_ip 검증의 정본 — 여기 fixed-address 에 있는 주소만 예약할 수 있다.
DHCP_HOSTS_PATH=/opt/pve-net-broker/network/dhcp-hosts.conf
